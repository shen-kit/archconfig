#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    {
      echo "$HOME/archconfig"

      fd . "$HOME/archconfig/dotfiles/" \
        -t d \
        --min-depth 1 \
        --max-depth 1

      fd '^\.git$' "$HOME/dev" \
        -H \
        -t d \
        --prune \
        --min-depth 3 \
        --max-depth 5 |
        sed -E 's|/\.git/?$||'

      fd '^\.proj$' "$HOME/dev" \
        -H \
        -t f \
        --min-depth 3 \
        --max-depth 5 \
        -X dirname
      } |
        sed "s|$HOME|~|" |
        fzf --cycle |
        sed "s|~|$HOME|"
      )
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename -- "$selected" | sed 's/[^[:alnum:]_-]/_/g')
# avoid dangerous names like 'bash' or 'nvim'
sanitised_name="_$selected_name"
tmux_running=$(pgrep -x tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$sanitised_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$sanitised_name" 2>/dev/null; then
    tmux new-session -d -s "$sanitised_name" -n "pi" -c "$selected" "zsh -c 'pi; exec zsh'"
    tmux new-window -t "$sanitised_name" -n "git" -c "$selected" "zsh -c 'lazygit; exec zsh'"
    tmux new-window -t "$sanitised_name" -n "nvim" -c "$selected" "zsh -c 'nvim .; exec zsh'"
    tmux new-window -t "$sanitised_name" -n "zsh" -c "$selected" "zsh"
    tmux select-window -t "$sanitised_name:nvim"
fi
tmux switch-client -t "$sanitised_name"
